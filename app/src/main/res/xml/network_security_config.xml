<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!--
      Student/debug convenience so the emulator and LAN devices can reach a local
      FastAPI server over HTTP. Production builds must use HTTPS and remove this.
    -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
